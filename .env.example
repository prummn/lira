# Optional model configuration for the backend. No key is required for local excerpts.
PAPER_READER_MODEL_BASE_URL=https://api.openai.com/v1
PAPER_READER_MODEL_NAME=gpt-4.1-mini
PAPER_READER_MODEL_API_KEY=

# Protocol: chat_completions (default) or responses.
PAPER_READER_MODEL_WIRE_API=chat_completions
# disabled omits reasoning parameters for nonreasoning models, including gpt-4.1-mini.
# Set an effort explicitly only when your selected model supports it.
PAPER_READER_MODEL_REASONING_EFFORT=disabled
# Request timeout in seconds; default 600, allowed range 1–1800.
PAPER_READER_MODEL_TIMEOUT=600
# For Chat Completions providers that use the older token parameter:
# PAPER_READER_MODEL_COMPLETION_PARAMETER=max_tokens
# PAPER_READER_MODEL_JSON_MODE=none

# SpacetimeAI profile: use these values with your key in the process environment.
# PAPER_READER_MODEL_BASE_URL=https://spacetimeai.cc
# PAPER_READER_MODEL_NAME=gpt-6.1-sol
# PAPER_READER_MODEL_WIRE_API=responses
# PAPER_READER_MODEL_REASONING_EFFORT=xhigh
# Optional long synthesis timeout (default 600, maximum 1800 seconds).
# PAPER_READER_MODEL_TIMEOUT=600

# Override only if you want a different local SQLite database or PDF directory.
# PAPER_READER_DATABASE_URL=sqlite:///D:/paper_reader/data/workspace.db
# PAPER_READER_STORAGE_DIR=D:/paper_reader/data/pdfs
