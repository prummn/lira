:4},{"text":" ","size":9.055620193481445,"flags":4},{"text":"Wang,","size":9.055620193481445,"flags":4},{"text":" ","size":9.055620193481445,"flags":4},{"text":"and","size":9.055620193481445,"flags":4},{"text":" ","size":9.055620193481445,"flags":4},{"text":"Zijia","size":9.055620193481445,"flags":4},{"text":" ","size":9.055620193481445,"flags":4},{"text":"Lu.","size":9.055620193481445,"flags":4},{"text":" ","size":9.055620193481445,"flags":4},{"text":"2018.","size":9.055620193481445,"flags":4},{"text":" ","size":9.055620193481445,"flags":4},{"text":"CRUD-RAG:","size":9.055620193481445,"flags":4},{"text":" ","size":9.055620193481445,"flags":4},{"text":"A","size":9.055620193481445,"flags":4}]},{"bbox":[45.827999114990234,189.94825744628906,440.1705017089844,198.8753204345703],"dir":[1.0,0.0],"spans":[{"text":"Comprehensive Chinese Benchmark for Retrieval-Augmented Generation of Large Language Models.","size":8.907927513122559,"flags":4},{"text":" J. ACM","size":8.907927513122559,"flags":6}]},{"bbox":[45.827999114990234,200.86341857910156,338.921630859375,209.82981872558594],"dir":[1.0,0.0],"spans":[{"text":"37, 4, Article 111 (August 2018), 28 pages. https://doi.org/XXXXXXX.XXXXXXX","size":8.966400146484375,"flags":4}]}]},{"type":0,"bbox":[45.827999114990234,221.64625549316406,138.92849731445312,231.60885620117188],"lines":[{"bbox":[45.827999114990234,221.64625549316406,50.94877624511719,231.60885620117188],"dir":[1.0,0.0],"spans":[{"text":"1","size":9.962599754333496,"flags":20}]},{"bbox":[60.911376953125,221.64625549316406,138.92849731445312,231.60885620117188],"dir":[1.0,0.0],"spans":[{"text":"INTRODUCTION","size":9.962599754333496,"flags":20}]}]},{"type":0,"bbox":[45.827999114990234,236.6358642578125,441.7069396972656,306.2983093261719],"lines":[{"bbox":[45.827999114990234,236.6358642578125,440.16973876953125,246.4983367919922],"dir":[1.0,0.0],"spans":[{"text":"Retrieval-augmented generation (RAG) is an advanced technique that leverages external knowledge","size":9.862470626831055,"flags":4}]},{"bbox":[45.827999114990234,248.4413299560547,440.16900634765625,258.5030517578125],"dir":[1.0,0.0],"spans":[{"text":"sources to enhance the text generation capabilities of large language models(LLMs). It retrieves","size":10.061732292175293,"flags":4}]},{"bbox":[45.827999114990234,260.5082092285156,440.1693420410156,270.4208679199219],"dir":[1.0,0.0],"spans":[{"text":"relevant paragraphs from a corpus based on the input, and feeds them to the LLMs along with the","size":9.9126615524292,"flags":4}]},{"bbox":[45.827999114990234,272.5008850097656,440.1697082519531,282.36334228515625],"dir":[1.0,0.0],"spans":[{"text":"input. With the help of external knowledge, LLMs can generate more accurate and credible responses","size":9.862470626831055,"flags":4}]},{"bbox":[45.827999114990234,284.313720703125,441.26776123046875,294.3656005859375],"dir":[1.0,0.0],"spans":[{"text":"and effectively address challenges such as outdated knowledge [","size":10.051863670349121,"flags":4},{"text":"17","size":9.962599754333496,"flags":4},{"text":"], hallucinations [","size":10.051863670349121,"flags":4},{"text":"3","size":9.962599754333496,"flags":4},{"text":",","size":10.051863670349121,"flags":4},{"text":" 8","size":9.962599754333496,"flags":4},{"text":",","size":10.051863670349121,"flags":4},{"text":" 31","size":9.962599754333496,"flags":4},{"text":",","size":10.051863670349121,"flags":4},{"text":" 54","size":9.962599754333496,"flags":4},{"text":"],","size":10.051863670349121,"flags":4}]},{"bbox":[45.827999114990234,296.335693359375,441.7069396972656,306.2983093261719],"dir":[1.0,0.0],"spans":[{"text":"and lack of domain expertise [","size":9.862470626831055,"flags":4},{"text":"26","size":9.962599754333496,"flags":4},{"text":",","size":9.862470626831055,"flags":4},{"text":" 40","size":9.962599754333496,"flags":4},{"text":"]. Therefore, RAG technology is attracting increasing attention.","size":9.862470626831055,"flags":4}]}]},{"type":0,"bbox":[45.827999114990234,308.3593444824219,440.1756591796875,449.76031494140625],"lines":[{"bbox":[55.79100036621094,308.3593444824219,440.1756591796875,318.23187255859375],"dir":[1.0,0.0],"spans":[{"text":"Although the effectiveness of retrieval-augmented strategies has been proven through extensive","size":9.872529029846191,"flags":4}]},{"bbox":[45.827999114990234,320.3218688964844,440.1695861816406,330.184326171875],"dir":[1.0,0.0],"spans":[{"text":"practice, their implementation still requires a significant amount of tuning. The overall performance","size":9.862470626831055,"flags":4}]},{"bbox":[45.827999114990234,332.2054443359375,440.1714782714844,342.1630554199219],"dir":[1.0,0.0],"spans":[{"text":"of the RAG system is affected by multiple factors, such as the retrieval model, construction of the","size":9.95761775970459,"flags":4}]},{"bbox":[45.827999114990234,344.1942138671875,440.1695251464844,354.10687255859375],"dir":[1.0,0.0],"spans":[{"text":"external knowledge base, and language model. Therefore, automatic evaluation of RAG systems is","size":9.9126615524292,"flags":4}]},{"bbox":[45.827999114990234,356.08929443359375,440.1683349609375,366.0817565917969],"dir":[1.0,0.0],"spans":[{"text":"crucial. Currently, there are only a few existing benchmarks for evaluating RAG performance, as","size":9.992443084716797,"flags":4}]},{"bbox":[45.827999114990234,368.1418762207031,440.16973876953125,378.00433349609375],"dir":[1.0,0.0],"spans":[{"text":"creating high-quality datasets and experimenting on them entail significant costs. These benchmarks","size":9.862470626831055,"flags":4}]},{"bbox":[45.827999114990234,380.0077819824219,440.17474365234375,389.99029541015625],"dir":[1.0,0.0],"spans":[{"text":"can be classified into two types: reference-required and reference-free evaluation. Reference-free","size":9.982504844665527,"flags":4}]},{"bbox":[45.827999114990234,391.95904541015625,440.16754150390625,401.9465026855469],"dir":[1.0,0.0],"spans":[{"text":"evaluation frameworks, such as RAGAS [","size":9.987475395202637,"flags":4},{"text":"12","size":9.962599754333496,"flags":4},{"text":"] and ARES [","size":9.987475395202637,"flags":4},{"text":"38","size":9.962599754333496,"flags":4},{"text":"], use LLM-generated data to evaluate","size":9.987475395202637,"flags":4}]},{"bbox":[45.827999114990234,403.8583068847656,440.1689758300781,413.9200439453125],"dir":[1.0,0.0],"spans":[{"text":"RAG systems on contextual relevance, faithfulness, and informativeness. These frameworks do","size":10.061732292175293,"flags":4}]},{"bbox":[45.827999114990234,415.85040283203125,440.1664733886719,425.8627014160156],"dir":[1.0,0.0],"spans":[{"text":"not depend on ground truth references, but only assess the coherence of the generated text with","size":10.012289047241211,"flags":4}]},{"bbox":[45.827999114990234,427.768310546875,440.16900634765625,437.8300476074219],"dir":[1.0,0.0],"spans":[{"text":"the retrieved context. This approach may be unreliable if the retrieved external information is","size":10.061732292175293,"flags":4}]},{"bbox":[45.827999114990234,439.7976989746094,94.28608703613281,449.76031494140625],"dir":[1.0,0.0],"spans":[{"text":"low-quality.","size":9.962599754333496,"flags":4}]}]},{"type":0,"bbox":[45.827999114990234,451.828857421875,441.2701110839844,581.2672729492188],"lines":[{"bbox":[55.79100036621094,451.828857421875,440.1740417480469,461.6913146972656],"dir":[1.0,0.0],"spans":[{"text":"Consequently, reference-required evaluations remain the predominant method for assessing RAG","size":9.862470626831055,"flags":4}]},{"bbox":[45.827999114990234,463.7087097167969,440.17022705078125,473.67132568359375],"dir":[1.0,0.0],"spans":[{"text":"systems. Existing benchmarks for reference-required evaluations, such as RGB [","size":9.872529029846191,"flags":4},{"text":"7","size":9.962599754333496,"flags":4},{"text":"] and NQ [","size":9.872529029846191,"flags":4},{"text":"23","size":9.962599754333496,"flags":4},{"text":"]. do","size":9.872529029846191,"flags":4}]},{"bbox":[45.827999114990234,475.71246337890625,440.1738586425781,485.610107421875],"dir":[1.0,0.0],"spans":[{"text":"have their limitations. First, they all rely on question answering tasks to measure the performance","size":9.89763069152832,"flags":4}]},{"bbox":[45.827999114990234,487.6938781738281,440.169677734375,497.55633544921875],"dir":[1.0,0.0],"spans":[{"text":"of RAG systems. Question answering is not the only RAG application scenario, and an optimization","size":9.862470626831055,"flags":4}]},{"bbox":[45.827999114990234,499.5699768066406,441.2701110839844,509.5375671386719],"dir":[1.0,0.0],"spans":[{"text":"strategy that works well for question answering may not be generalized to other scenarios. Thus,","size":9.96757984161377,"flags":4}]},{"bbox":[45.827999114990234,511.5436706542969,441.269287109375,521.486328125],"dir":[1.0,0.0],"spans":[{"text":"these benchmarks may not capture the full potential of RAG systems. Second, in the experiments,","size":9.942654609680176,"flags":4}]},{"bbox":[45.827999114990234,523.5072021484375,440.1684265136719,533.4398803710938],"dir":[1.0,0.0],"spans":[{"text":"current evaluations usually focus on evaluating the LLM part of the RAG pipeline, while ignoring","size":9.932666778564453,"flags":4}]},{"bbox":[45.827999114990234,535.4546508789062,440.16796875,545.3973388671875],"dir":[1.0,0.0],"spans":[{"text":"the retrieval model and external knowledge base construction. These components are also crucial","size":9.942654609680176,"flags":4}]},{"bbox":[45.827999114990234,547.3611450195312,440.1680908203125,557.3684692382812],"dir":[1.0,0.0],"spans":[{"text":"for RAG systems, as they determine the quality and relevance of retrieved passages and external","size":10.007330894470215,"flags":4}]},{"bbox":[45.827999114990234,559.3721923828125,440.16839599609375,569.3048706054688],"dir":[1.0,0.0],"spans":[{"text":"knowledge. Therefore, a comprehensive evaluation of the RAG system may not be obtained using","size":9.932666778564453,"flags":4}]},{"bbox":[45.827999114990234,571.3046875,149.76779174804688,581.2672729492188],"dir":[1.0,0.0],"spans":[{"text":"any existing benchmarks.","size":9.962599754333496,"flags":4}]}]},{"type":0,"bbox":[45.479000091552734,583.3348388671875,441.7005310058594,641.0631103515625],"lines":[{"bbox":[55.79100036621094,583.3348388671875,440.1741027832031,593.1973266601562],"dir":[1.0,0.0],"spans":[{"text":"To evaluate the performance of RAG in different application scenarios, we need a comprehensive","size":9.862470626831055,"flags":4}]},{"bbox":[45.827999114990234,595.2156982421875,440.1684875488281,605.1782836914062],"dir":[1.0,0.0],"spans":[{"text":"benchmark that covers more than just the question answering task. Lewis et al","size":9.867501258850098,"flags":4},{"text":". [25]","size":9.962599754333496,"flags":4},{"text":" argue that the","size":9.867501258850098,"flags":4}]},{"bbox":[45.827999114990234,607.2269897460938,441.7005310058594,617.1146240234375],"dir":[1.0,0.0],"spans":[{"text":"core of RAG systems is their interactive way of combining LLMs with external knowledge sources.","size":9.887598037719727,"flags":4}]},{"bbox":[45.479000091552734,619.125732421875,440.1712646484375,629.0883178710938],"dir":[1.0,0.0],"spans":[{"text":"And following [","size":9.89261531829834,"flags":4},{"text":"22","size":9.962599754333496,"flags":4},{"text":"], we can group any interaction with external knowledge sources into four basic","size":9.89261531829834,"flags":4}]},{"bbox":[45.827999114990234,631.0211181640625,441.2662658691406,641.0631103515625],"dir":[1.0,0.0],"spans":[{"text":"actions: create, read, update, and delete, which are also known as CRUD actions [","size":10.041984558105469,"flags":4},{"text":"42","size":9.962599754333496,"flags":4},{"text":"]. Therefore,","size":10.041984558105469,"flags":4}]}]},{"type":0,"bbox":[45.68600082397461,648.8690795898438,334.51318359375,658.3862915039062],"lines":[{"bbox":[45.68600082397461,648.8690795898438,334.513183593