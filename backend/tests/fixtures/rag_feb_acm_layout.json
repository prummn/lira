765625,261.3677673339844],"lines":[{"bbox":[80.6969985961914,208.4984130859375,531.306884765625,217.55404663085938],"dir":[1.0,0.0],"spans":[{"text":"Federated search systems aggregate results from multiple search engines, selecting appropriate sources to enhance result","size":9.055620193481445,"flags":4}]},{"bbox":[80.6969985961914,219.58526611328125,531.3021240234375,228.47061157226562],"dir":[1.0,0.0],"spans":[{"text":"quality and align with user intent. With the increasing uptake of Retrieval-Augmented Generation (RAG) pipelines, federated","size":8.885335922241211,"flags":4}]},{"bbox":[80.6969985961914,230.41644287109375,531.3067626953125,239.47207641601562],"dir":[1.0,0.0],"spans":[{"text":"search can play a pivotal role in sourcing relevant information across heterogeneous data sources to generate informed","size":9.055620193481445,"flags":4}]},{"bbox":[80.6969985961914,241.45587158203125,531.3050537109375,250.40431213378906],"dir":[1.0,0.0],"spans":[{"text":"responses. However, existing datasets, such as those developed in the past TREC FedWeb tracks, predate the RAG paradigm","size":8.94844913482666,"flags":4}]},{"bbox":[80.6969985961914,252.40138244628906,347.026123046875,261.3677673339844],"dir":[1.0,0.0],"spans":[{"text":"shift and lack representation of modern information retrieval challenges.","size":8.966400146484375,"flags":4}]}]},{"type":0,"bbox":[80.4280014038086,261.3766174316406,532.6871337890625,349.0387878417969],"lines":[{"bbox":[90.66000366210938,261.3766174316406,532.6871337890625,272.3043518066406],"dir":[1.0,0.0],"spans":[{"text":"To bridge this gap, we present FeB4RAG","size":8.876283645629883,"flags":4},{"text":" ","size":7.27269983291626,"flags":4},{"text":"1","size":7.27269983291626,"flags":5},{"text":", a novel dataset specifically designed for federated search within RAG frameworks.","size":8.876283645629883,"flags":4}]},{"bbox":[80.4280014038086,273.9577941894531,531.3057250976562,283.3080749511719],"dir":[1.0,0.0],"spans":[{"text":"This dataset, derived from 16 sub-collections of the widely used","size":9.055620193481445,"flags":4},{"text":" BEIR","size":8.966400146484375,"flags":4},{"text":" benchmarking collection, includes 790 information","size":9.055620193481445,"flags":4}]},{"bbox":[80.6969985961914,285.2673034667969,531.3063354492188,294.24713134765625],"dir":[1.0,0.0],"spans":[{"text":"requests (akin to conversational queries) tailored for chatbot applications, along with top results returned by each resource","size":8.979839324951172,"flags":4}]},{"bbox":[80.6969985961914,296.2735290527344,531.3040771484375,305.1904602050781],"dir":[1.0,0.0],"spans":[{"text":"and associated LLM-derived relevance judgements . Additionally, to support the need for this collection, we demonstrate the","size":8.916949272155762,"flags":4}]},{"bbox":[80.6969985961914,307.24267578125,531.2987670898438,316.1460876464844],"dir":[1.0,0.0],"spans":[{"text":"impact on response generation of a high quality federated search system for RAG compared to a naive approach to federated","size":8.903413772583008,"flags":4}]},{"bbox":[80.6969985961914,318.1712341308594,532.6815185546875,327.1152038574219],"dir":[1.0,0.0],"spans":[{"text":"search. We do so by comparing answers generated through the RAG pipeline through a qualitative side-by-side comparison.","size":8.943955421447754,"flags":4}]},{"bbox":[80.6969985961914,329.0464172363281,531.306884765625,338.10205078125],"dir":[1.0,0.0],"spans":[{"text":"Our collection fosters and supports the development and evaluation of new federated search methods, especially in the","size":9.055620193481445,"flags":4}]},{"bbox":[80.6969985961914,340.0723876953125,174.21656799316406,349.0387878417969],"dir":[1.0,0.0],"spans":[{"text":"context of RAG pipelines.","size":8.966400146484375,"flags":4}]}]},{"type":0,"bbox":[80.6969985961914,355.0292053222656,531.9390258789062,375.60479736328125],"lines":[{"bbox":[80.6969985961914,355.0292053222656,531.9390258789062,364.6255798339844],"dir"